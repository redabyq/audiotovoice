# Create a bot through @BotFather, then paste its token here.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_token

# true — bot is available to everyone. false — only IDs from ALLOWED_USER_IDS.
ALLOW_ALL_USERS=true
# Telegram user IDs, separated by commas. Used only when ALLOW_ALL_USERS=false.
ALLOWED_USER_IDS=123456789,987654321
